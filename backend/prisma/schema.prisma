generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== SCHOOLS & TENANTS ====================

model School {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(255)
  code              String   @unique @db.VarChar(20)
  address           String?  @db.Text
  province          String?  @db.VarChar(100)
  district          String?  @db.VarChar(100)
  phone             String?  @db.VarChar(50)
  email             String?  @db.VarChar(255)
  website           String?  @db.VarChar(255)
  logoUrl           String?  @map("logo_url") @db.Text
  schoolType        String?  @map("school_type") @db.VarChar(50)
  accreditation     String?  @db.VarChar(100)
  subscriptionTier  String   @default("free") @map("subscription_tier") @db.VarChar(50)
  isActive          Boolean  @default(true) @map("is_active")
  settings          Json     @default("{}") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  users            User[]
  students         Student[]
  teachers         Teacher[]
  classes          Class[]
  subjects         Subject[]
  attendance       Attendance[]
  assessments      Assessment[]
  exams            Exam[]
  marks            Mark[]
  gradeBoundaries  GradeBoundary[]
  reportCards      ReportCard[]
  notifications    Notification[]
  roles            Role[]
  academicYears    AcademicYear[]
  terms            Term[]
  timetableEntries TimetableEntry[]
  feeRecords       FeeRecord[]
  payments         Payment[]
  auditLogs        AuditLog[]

  @@map("schools")
}

// ==================== USERS & AUTH ====================

model User {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String?   @map("school_id") @db.Uuid
  email          String    @unique @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  avatarUrl      String?   @map("avatar_url") @db.Text
  role           String    @db.VarChar(50)
  isActive       Boolean   @default(true) @map("is_active")
  emailVerified  Boolean   @default(false) @map("email_verified")
  lastLogin      DateTime? @map("last_login") @db.Timestamptz
  preferences    Json      @default("{}") @db.JsonB
  refreshToken   String?   @map("refresh_token") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  school       School?        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student?
  teacher      Teacher?
  parent       Parent?
  markedAttendance Attendance[] @relation("markedBy")
  createdAssessments Assessment[] @relation("createdBy")
  gradedMarks  Mark[]         @relation("gradedBy")
  sentNotifications Notification[] @relation("sender")
  receivedNotifications Notification[] @relation("recipient")
  auditLogs    AuditLog[]

  @@index([email])
  @@index([schoolId, role])
  @@map("users")
}

// ==================== STUDENTS ====================

model Student {
  id                   String   @id @default(uuid()) @db.Uuid
  schoolId             String   @map("school_id") @db.Uuid
  userId               String?  @unique @map("user_id") @db.Uuid
  studentId            String   @unique @map("student_id") @db.VarChar(50)
  firstName            String   @map("first_name") @db.VarChar(100)
  middleName           String?  @map("middle_name") @db.VarChar(100)
  lastName             String   @map("last_name") @db.VarChar(100)
  dateOfBirth          DateTime @map("date_of_birth") @db.Date
  gender               String?  @db.VarChar(10)
  nationality          String   @default("Papua New Guinean") @db.VarChar(100)
  birthCertNo          String?  @map("birth_cert_no") @db.VarChar(100)
  nationalIdNo         String?  @map("national_id_no") @db.VarChar(100)
  address              String?  @db.Text
  city                 String?  @db.VarChar(100)
  province             String?  @db.VarChar(100)
  postalCode           String?  @map("postal_code") @db.VarChar(20)
  phone                String?  @db.VarChar(50)
  email                String?  @db.VarChar(255)
  emergencyContactName String?  @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactPhone String? @map("emergency_contact_phone") @db.VarChar(50)
  medicalInfo          String?  @map("medical_info") @db.Text
  bloodGroup           String?  @map("blood_group") @db.VarChar(5)
  allergies            String?  @db.Text
  profilePhoto         String?  @map("profile_photo") @db.Text
  enrollmentDate       DateTime @map("enrollment_date") @db.Date
  status               String   @default("active") @db.VarChar(20)
  academicYearId       String?  @map("academic_year_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  academicYear    AcademicYear?      @relation(fields: [academicYearId], references: [id])
  studentParents  StudentParent[]
  studentClasses  StudentClass[]
  attendance      Attendance[]
  marks           Mark[]
  reportCards     ReportCard[]
  feeRecords      FeeRecord[]
  payments        Payment[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([studentId])
  @@map("students")
}

// ==================== PARENTS ====================

model Parent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  occupation   String?  @db.VarChar(100)
  relationship String?  @db.VarChar(50)
  isPrimary    Boolean  @default(true) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentParents StudentParent[]

  @@map("parents")
}

model StudentParent {
  id                 String   @id @default(uuid()) @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  parentId           String   @map("parent_id") @db.Uuid
  relationship       String?  @db.VarChar(50)
  isEmergencyContact Boolean  @default(false) @map("is_emergency_contact")
  canPickup          Boolean  @default(false) @map("can_pickup")
  createdAt          DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
  @@map("student_parents")
}

// ==================== TEACHERS ====================

model Teacher {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  employeeId     String?  @unique @map("employee_id") @db.VarChar(50)
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  gender         String?  @db.VarChar(10)
  qualification  String?  @db.VarChar(255)
  specialization String?  @db.VarChar(255)
  dateHired      DateTime? @map("date_hired") @db.Date
  phone          String?  @db.VarChar(50)
  address        String?  @db.Text
  isClassTeacher Boolean  @default(false) @map("is_class_teacher")
  classTeacherOf String?  @map("class_teacher_of") @db.Uuid
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  classesAsTeacher Class[]           @relation("ClassTeacher")
  teacherSubjects TeacherSubject[]
  timetableEntries TimetableEntry[]
  invigilatedExams ExamSubject[]     @relation("invigilator")

  @@index([schoolId])
  @@map("teachers")
}

// ==================== CLASSES ====================

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  name           String   @db.VarChar(100)
  grade          String   @db.VarChar(50)
  section        String?  @db.VarChar(50)
  academicYearId String?  @map("academic_year_id") @db.Uuid
  classTeacherId String?  @map("class_teacher_id") @db.Uuid
  roomNumber     String?  @map("room_number") @db.VarChar(50)
  capacity       Int      @default(40)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear?      @relation(fields: [academicYearId], references: [id])
  classTeacher      Teacher?           @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  studentClasses    StudentClass[]
  teacherSubjects   TeacherSubject[]
  assessments       Assessment[]
  examSubjects      ExamSubject[]
  timetableEntries  TimetableEntry[]
  attendanceRecords Attendance[]       @relation("classAttendance")

  @@unique([schoolId, name, academicYearId])
  @@index([schoolId])
  @@map("classes")
}

model StudentClass {
  id             String   @id @default(uuid()) @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  academicYearId String?  @map("academic_year_id") @db.Uuid
  termId         String?  @map("term_id") @db.Uuid
  enrolledDate   DateTime @default(now()) @map("enrolled_date") @db.Date

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  term         Term?        @relation(fields: [termId], references: [id])

  @@unique([studentId, classId, academicYearId])
  @@index([studentId])
  @@index([classId])
  @@map("student_classes")
}

// ==================== SUBJECTS ====================

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String   @db.VarChar(255)
  code        String?  @db.VarChar(50)
  category    String?  @db.VarChar(50)
  creditHours Int      @default(1) @map("credit_hours")
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects  TeacherSubject[]
  assessments      Assessment[]
  examSubjects     ExamSubject[]
  marks            Mark[]
  timetableEntries TimetableEntry[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

model TeacherSubject {
  id             String   @id @default(uuid()) @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  academicYearId String?  @map("academic_year_id") @db.Uuid

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@unique([teacherId, subjectId, classId, academicYearId])
  @@map("teacher_subjects")
}

// ==================== ATTENDANCE ====================

model Attendance {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  classId      String?   @map("class_id") @db.Uuid
  date         DateTime  @db.Date
  status       String    @db.VarChar(20)
  checkInTime  String?   @map("check_in_time") @db.VarChar(10)
  checkOutTime String?   @map("check_out_time") @db.VarChar(10)
  lateMinutes  Int       @default(0) @map("late_minutes")
  reason       String?   @db.Text
  remarks      String?   @db.Text
  markedBy     String?   @map("marked_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class?  @relation("classAttendance", fields: [classId], references: [id])
  marker  User?   @relation("markedBy", fields: [markedBy], references: [id])

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([studentId])
  @@index([status])
  @@map("attendance")
}

// ==================== ACADEMICS ====================

model Assessment {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  classId        String?  @map("class_id") @db.Uuid
  subjectId      String?  @map("subject_id") @db.Uuid
  name           String   @db.VarChar(255)
  type           String?  @db.VarChar(50)
  maxScore       Decimal  @map("max_score") @db.Decimal(10, 2)
  weight         Decimal? @default(0) @db.Decimal(5, 2)
  date           DateTime? @db.Date
  termId         String?  @map("term_id") @db.Uuid
  academicYearId String?  @map("academic_year_id") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class?    @relation(fields: [classId], references: [id])
  subject     Subject?  @relation(fields: [subjectId], references: [id])
  term        Term?     @relation(fields: [termId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  creator     User?     @relation("createdBy", fields: [createdBy], references: [id])
  marks       Mark[]    @relation("assessmentMarks")

  @@index([classId, subjectId])
  @@map("assessments")
}

model Exam {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  name           String   @db.VarChar(255)
  type           String?  @db.VarChar(50)
  termId         String?  @map("term_id") @db.Uuid
  academicYearId String?  @map("academic_year_id") @db.Uuid
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  isPublished    Boolean  @default(false) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term         Term?         @relation(fields: [termId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  examSubjects ExamSubject[]

  @@map("exams")
}

model ExamSubject {
  id            String   @id @default(uuid()) @db.Uuid
  examId        String   @map("exam_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  classId       String?  @map("class_id") @db.Uuid
  date          DateTime? @db.Date
  startTime     String?  @map("start_time") @db.VarChar(10)
  endTime       String?  @map("end_time") @db.VarChar(10)
  maxScore      Decimal? @map("max_score") @db.Decimal(10, 2)
  passScore     Decimal? @map("pass_score") @db.Decimal(10, 2)
  invigilatorId String?  @map("invigilator_id") @db.Uuid
  venue         String?  @db.VarChar(255)

  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id])
  class       Class?   @relation(fields: [classId], references: [id])
  invigilator Teacher? @relation("invigilator", fields: [invigilatorId], references: [id])
  marks       Mark[]   @relation("examMarks")

  @@map("exam_subjects")
}

model Mark {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  subjectId     String?  @map("subject_id") @db.Uuid
  assessmentId  String?  @map("assessment_id") @db.Uuid
  examSubjectId String?  @map("exam_subject_id") @db.Uuid
  score         Decimal  @db.Decimal(10, 2)
  maxScore      Decimal? @map("max_score") @db.Decimal(10, 2)
  grade         String?  @db.VarChar(5)
  gradePoint    Decimal? @map("grade_point") @db.Decimal(3, 2)
  remarks       String?  @db.Text
  gradedBy      String?  @map("graded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject?      @relation(fields: [subjectId], references: [id])
  assessment  Assessment?   @relation("assessmentMarks", fields: [assessmentId], references: [id], onDelete: Cascade)
  examSubject ExamSubject?  @relation("examMarks", fields: [examSubjectId], references: [id], onDelete: Cascade)
  grader      User?         @relation("gradedBy", fields: [gradedBy], references: [id])

  @@index([studentId])
  @@index([assessmentId])
  @@index([studentId, subjectId])
  @@map("marks")
}

model GradeBoundary {
  id           String  @id @default(uuid()) @db.Uuid
  schoolId     String  @map("school_id") @db.Uuid
  grade        String  @db.VarChar(5)
  gradePoint   Decimal @map("grade_point") @db.Decimal(3, 2)
  minPercentage Decimal @map("min_percentage") @db.Decimal(5, 2)
  maxPercentage Decimal @map("max_percentage") @db.Decimal(5, 2)
  description  String? @db.VarChar(100)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, grade])
  @@map("grade_boundaries")
}

model ReportCard {
  id                    String   @id @default(uuid()) @db.Uuid
  schoolId              String   @map("school_id") @db.Uuid
  studentId             String   @map("student_id") @db.Uuid
  termId                String?  @map("term_id") @db.Uuid
  academicYearId        String?  @map("academic_year_id") @db.Uuid
  totalMarks            Decimal? @map("total_marks") @db.Decimal(10, 2)
  totalCredits          Int?     @map("total_credits")
  gpa                   Decimal? @db.Decimal(3, 2)
  classRank             Int?     @map("class_rank")
  classSize             Int?     @map("class_size")
  attendancePercentage  Decimal? @map("attendance_percentage") @db.Decimal(5, 2)
  teacherRemarks        String?  @map("teacher_remarks") @db.Text
  principalRemarks      String?  @map("principal_remarks") @db.Text
  pdfUrl                String?  @map("pdf_url") @db.Text
  isPublished           Boolean  @default(false) @map("is_published")
  createdAt             DateTime @default(now()) @map("created_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term?        @relation(fields: [termId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, termId, academicYearId])
  @@index([studentId])
  @@map("report_cards")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String?   @map("school_id") @db.Uuid
  senderId    String?   @map("sender_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  type        String    @db.VarChar(50)
  title       String    @db.VarChar(255)
  message     String?   @db.Text
  channel     String?   @db.VarChar(20)
  isRead      Boolean   @default(false) @map("is_read")
  isSent      Boolean   @default(false) @map("is_sent")
  readAt      DateTime? @map("read_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at")

  school    School? @relation(fields: [schoolId], references: [id])
  sender    User?   @relation("sender", fields: [senderId], references: [id])
  recipient User    @relation("recipient", fields: [recipientId], references: [id])

  @@index([recipientId, isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// ==================== ROLES & PERMISSIONS ====================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  school      School?      @relation(fields: [schoolId], references: [id])
  permissions Permission[]

  @@unique([schoolId, name])
  @@map("roles")
}

model Permission {
  id         String   @id @default(uuid()) @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  resource   String   @db.VarChar(100)
  action     String   @db.VarChar(50)
  conditions Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

// ==================== ACADEMIC CALENDAR ====================

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String   @db.VarChar(100)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students   Student[]
  classes    Class[]
  studentClasses StudentClass[]
  teacherSubjects TeacherSubject[]
  assessments  Assessment[]
  exams       Exam[]
  reportCards ReportCard[]
  feeRecords  FeeRecord[]
  terms       Term[]
  timetableEntries TimetableEntry[]

  @@unique([schoolId, name])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String   @db.VarChar(100)
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  isCurrent      Boolean  @default(false) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  studentClasses StudentClass[]
  assessments  Assessment[]
  exams        Exam[]
  reportCards  ReportCard[]
  feeRecords   FeeRecord[]
  timetableEntries TimetableEntry[]

  @@unique([schoolId, academicYearId, name])
  @@map("terms")
}

// ==================== TIMETABLE ====================

model TimetableEntry {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  teacherId      String?  @map("teacher_id") @db.Uuid
  dayOfWeek      Int      @map("day_of_week")
  startTime      String   @map("start_time") @db.VarChar(10)
  endTime        String   @map("end_time") @db.VarChar(10)
  roomNumber     String?  @map("room_number") @db.VarChar(50)
  academicYearId String?  @map("academic_year_id") @db.Uuid
  termId         String?  @map("term_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id])
  teacher      Teacher?     @relation(fields: [teacherId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  term         Term?        @relation(fields: [termId], references: [id])

  @@unique([classId, dayOfWeek, startTime, roomNumber])
  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@map("timetable_entries")
}

// ==================== FEES & PAYMENTS ====================

model FeeRecord {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  feeType        String   @map("fee_type") @db.VarChar(100)
  amount         Decimal  @db.Decimal(12, 2)
  amountPaid     Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  dueDate        DateTime? @map("due_date") @db.Date
  termId         String?  @map("term_id") @db.Uuid
  academicYearId String?  @map("academic_year_id") @db.Uuid
  status         String   @default("pending") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term?        @relation(fields: [termId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  payments     Payment[]

  @@index([studentId])
  @@index([status])
  @@map("fee_records")
}

model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  feeRecordId     String?  @map("fee_record_id") @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String?  @map("payment_method") @db.VarChar(50)
  transactionRef  String?  @map("transaction_ref") @db.VarChar(255)
  paymentDate     DateTime @default(now()) @map("payment_date") @db.Timestamptz
  receiptNumber   String?  @map("receipt_number") @db.VarChar(100)
  receivedBy      String?  @map("received_by") @db.Uuid
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  school    School    @relation(fields: [schoolId], references: [id])
  feeRecord FeeRecord? @relation(fields: [feeRecordId], references: [id])
  student   Student   @relation(fields: [studentId], references: [id])

  @@map("payments")
}

// ==================== AUDIT LOGS ====================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String?  @map("school_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  changes    Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  school School? @relation(fields: [schoolId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([schoolId, createdAt])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

